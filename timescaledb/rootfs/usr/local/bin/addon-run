#!/usr/bin/env bash
# Add-on entrypoint: validate options, init or upgrade the cluster, write the
# generated config and hand over to PostgreSQL.
set -euo pipefail
# shellcheck source=../lib/addon/common.sh
source /usr/local/lib/addon/common.sh

NEW_BIN=$(pg_config --bindir)
NEW_MAJOR=$(pg_major "$NEW_BIN")

validate_options() {
    [ -f "$OPTIONS" ] || die "No options found at $OPTIONS"
    local bad

    bad=$(opt '[.users[] | select((.password // "") == "") | .name] | join(", ")')
    [ -z "$bad" ] || die "Set a password for user(s): $bad"

    bad=$(opt '[.pg_hba[] | select(.type == "local" and (.address // "") != "")] | length')
    [ "$bad" = 0 ] || die "pg_hba rules of type 'local' must not have an address"
    bad=$(opt '[.pg_hba[] | select(.type != "local" and (.address // "") == "")] | length')
    [ "$bad" = 0 ] || die "pg_hba rules of type host/hostssl/hostnossl need an address, e.g. 10.0.0.0/8"

    # shellcheck disable=SC2016 # jq variables, not shell
    bad=$(opt '([.users[].name] + ["postgres"]) as $u | [.databases[] | select(.owner != null and (.owner as $o | $u | index($o) | not)) | .owner] | unique | join(", ")')
    [ -z "$bad" ] || die "Database owner(s) not listed under users: $bad"
}

init_cluster() {
    [ -s "$PGDATA/PG_VERSION" ] && return
    log "Initializing a new PostgreSQL $NEW_MAJOR cluster in $PGDATA"
    mkdir -p "$PGDATA"
    chown postgres:postgres "$PGDATA"
    chmod 700 "$PGDATA"
    as_pg initdb -D "$PGDATA" -U postgres -E UTF8 --locale=C.UTF-8 \
        --auth-local=trust --auth-host=scram-sha-256 >/dev/null
}

upgrade_cluster() {
    local data_major prev_major
    data_major=$(cat "$PGDATA/PG_VERSION")
    [ "$data_major" = "$NEW_MAJOR" ] && return

    [ "$data_major" -lt "$NEW_MAJOR" ] ||
        die "Data is from PostgreSQL $data_major but this add-on runs $NEW_MAJOR. Downgrades are not possible; restore a backup of the add-on instead."
    prev_major=$(cat "$PREV_DIR/PG_MAJOR")
    [ "$data_major" = "$prev_major" ] ||
        die "Data is from PostgreSQL $data_major; this add-on version can only upgrade from $prev_major. Install an intermediate add-on version first, or dump and restore."

    local old_bin=$PREV_DIR/bin new_dir=/data/postgres.upgrade
    log "Upgrading data from PostgreSQL $data_major to $NEW_MAJOR (this can take a while)"

    # pg_upgrade needs the same timescaledb version on both sides, so update
    # the extension with the old server first.
    log "Updating timescaledb extension using PostgreSQL $data_major"
    as_pg "$old_bin/pg_ctl" -D "$PGDATA" -w -t 3600 -l /tmp/pg-old.log \
        -o "-c listen_addresses='' -c unix_socket_directories=$SOCKET_DIR -c jit=off" start ||
        { cat /tmp/pg-old.log >&2; die "Could not start PostgreSQL $data_major for the upgrade"; }
    update_timescaledb
    local locale
    locale=$(sql -d postgres -At -F ' ' -c \
        "SELECT pg_encoding_to_char(encoding), datlocprovider, datcollate, datctype FROM pg_database WHERE datname = 'template0'")
    as_pg "$old_bin/pg_ctl" -D "$PGDATA" -w -t 3600 -m fast stop

    local encoding provider collate ctype checksums
    read -r encoding provider collate ctype <<<"$locale"
    [ "$provider" = c ] || die "Automatic upgrade only supports clusters using the libc locale provider (found '$provider')"
    checksums=--data-checksums
    if as_pg "$old_bin/pg_controldata" "$PGDATA" | grep -qE '^Data page checksum version:[[:space:]]+0$'; then
        checksums=--no-data-checksums
    fi

    rm -rf "$new_dir"
    mkdir -p "$new_dir"
    chown postgres:postgres "$new_dir"
    chmod 700 "$new_dir"
    as_pg initdb -D "$new_dir" -U postgres -E "$encoding" --lc-collate="$collate" --lc-ctype="$ctype" \
        "$checksums" --auth-local=trust --auth-host=scram-sha-256 >/dev/null

    log "Running pg_upgrade"
    if ! (cd /tmp && as_pg pg_upgrade -U postgres --link -j "$(nproc)" \
        -b "$old_bin" -B "$NEW_BIN" -d "$PGDATA" -D "$new_dir" \
        -O "-c shared_preload_libraries=timescaledb -c timescaledb.telemetry_level=off"); then
        find "$new_dir" -path '*pg_upgrade_output.d*' -name '*.log' -exec tail -n 50 {} + >&2 || true
        if [ -f "$PGDATA/global/pg_control.old" ]; then
            mv "$PGDATA/global/pg_control.old" "$PGDATA/global/pg_control"
        fi
        rm -rf "$new_dir"
        die "pg_upgrade failed. Your data in $PGDATA was left as PostgreSQL $data_major; restore a backup or pin the previous add-on version."
    fi

    rm -rf "$PGDATA"
    mv "$new_dir" "$PGDATA"
    touch "$ANALYZE_FLAG"
    log "Upgrade to PostgreSQL $NEW_MAJOR finished"
}

write_config() {
    local include="include_dir = '$CONF_DIR'"
    grep -qxF "$include" "$PGDATA/postgresql.conf" || echo "$include" >>"$PGDATA/postgresql.conf"

    mkdir -p "$CONF_DIR"
    rm -f "$CONF_DIR"/*.conf
    local max_conns
    max_conns=$(opt '.max_connections')

    if [ "$(opt '.tune')" = true ]; then
        local memory cpus
        memory=$(opt '.memory // empty')
        # Default to a quarter of the host's RAM; Home Assistant lives here too.
        [ -n "$memory" ] || memory="$(($(awk '/^MemTotal:/ {print $2}' /proc/meminfo) / 4 / 1024))MB"
        cpus=$(opt '.cpus // empty')
        [ -n "$cpus" ] || cpus=$(nproc)
        echo "shared_preload_libraries = 'timescaledb'" >"$CONF_DIR/10-tune.conf"
        timescaledb-tune --yes --quiet -color=false --conf-path="$CONF_DIR/10-tune.conf" \
            --memory="$memory" --cpus="$cpus" --max-conns="$max_conns" --pg-version="$NEW_MAJOR" >/dev/null
        log "Tuned for $memory memory, $cpus CPUs, $max_conns connections"
    else
        printf "shared_preload_libraries = 'timescaledb'\nmax_connections = %s\n" "$max_conns" >"$CONF_DIR/10-tune.conf"
    fi

    local telemetry=off
    [ "$(opt '.telemetry')" = true ] && telemetry=basic
    cat >"$CONF_DIR/20-addon.conf" <<EOF
listen_addresses = '*'
unix_socket_directories = '$SOCKET_DIR'
hba_file = '$HBA_FILE'
timescaledb.telemetry_level = '$telemetry'
logging_collector = off
EOF

    opt '.postgresql_config[]' >"$CONF_DIR/30-user.conf"
}

# The container's own IPv4 network, i.e. the Supervisor's internal network
# that Home Assistant and other add-ons connect from.
internal_network() {
    local cidr a b c d prefix n mask
    cidr=$(ip -o -4 addr show scope global | awk '{print $4; exit}')
    [ -n "$cidr" ] || return 1
    prefix=${cidr#*/}
    IFS=. read -r a b c d <<<"${cidr%/*}"
    mask=$(((0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF))
    n=$((((a << 24) | (b << 16) | (c << 8) | d) & mask))
    echo "$((n >> 24 & 255)).$((n >> 16 & 255)).$((n >> 8 & 255)).$((n & 255))/$prefix"
}

write_hba() {
    local internal external
    internal=$(internal_network) || die "Could not determine the add-on's network address"
    external=reject
    [ "$(opt '.external_access')" = true ] && external=scram-sha-256
    {
        echo "# Generated by the add-on on every start; use the pg_hba option instead."
        echo "local all postgres trust"
        opt '.pg_hba[] | [.type, .database, .user, (.address // empty), .method] | join("  ")'
        echo "local all all trust"
        echo "host  all all 127.0.0.1/32 scram-sha-256"
        echo "host  all all ::1/128      scram-sha-256"
        echo "host  all all $internal scram-sha-256"
        echo "host  all all 0.0.0.0/0 $external"
        echo "host  all all ::/0      $external"
    } >"$HBA_FILE"
    chmod 644 "$HBA_FILE"
    log "Home Assistant network $internal: allowed; everything else: $external"
}

# The host port is set in the add-on's Network section, which only the
# Supervisor controls; warn when it contradicts external_access.
check_port_mapping() {
    [ -n "${SUPERVISOR_TOKEN:-}" ] || return 0
    local port
    port=$(wget -qO- --header "Authorization: Bearer $SUPERVISOR_TOKEN" http://supervisor/addons/self/info 2>/dev/null |
        jq -r '.data.network["5432/tcp"] // empty') || return 0
    if [ "$(opt '.external_access')" = true ] && [ -z "$port" ]; then
        warn "external_access is on, but no host port is set for 5432/tcp in the Network section, so only Home Assistant and add-ons can connect"
    elif [ "$(opt '.external_access')" != true ] && [ -n "$port" ]; then
        warn "Port $port is published, but external_access is off, so connections from outside Home Assistant are rejected"
    fi
}

# nginx serves the ingress panel: DbGate when the explorer is enabled, a
# short notice otherwise. Only the Supervisor's ingress proxy may connect.
start_ingress() {
    local location
    mkdir -p /run/addon
    chmod 700 /run/addon
    if [ "$(opt '.explorer')" = true ]; then
        head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' >"$EXPLORER_PASSWORD_FILE"
        chmod 600 "$EXPLORER_PASSWORD_FILE"
        location="proxy_pass http://127.0.0.1:$EXPLORER_PORT;
            proxy_http_version 1.1;
            proxy_set_header Upgrade \$http_upgrade;
            proxy_set_header Connection \$connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 1h;
            client_max_body_size 50m;"
    else
        rm -f "$EXPLORER_PASSWORD_FILE"
        location="default_type text/html;
            return 200 '<!doctype html><meta name=color-scheme content=\"light dark\"><body style=\"font-family:sans-serif;padding:2em\"><h2>DB explorer is off</h2><p>Enable <code>explorer</code> in the add-on configuration and restart the add-on.</p>';"
    fi
    cat >/run/addon/nginx.conf <<EOF
worker_processes 1;
pid /run/addon/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 64; }
http {
    access_log off;
    map \$http_upgrade \$connection_upgrade { default upgrade; '' close; }
    server {
        listen $INGRESS_PORT;
        allow ${INGRESS_ALLOW:-172.30.32.2};
        deny all;
        location / {
            $location
        }
    }
}
EOF
    nginx -c /run/addon/nginx.conf
    if [ "$(opt '.explorer')" = true ]; then
        (/usr/local/bin/addon-explorer &)
    fi
}

# Start after a restore from a hot backup: /data has dumps but no cluster.
# Loads them into the freshly initialized cluster before the real start.
restore_dump() {
    local rc=0
    log "Restoring databases from the backup (this can take a while)"
    # Socket only: no client can connect before the restore is complete.
    as_pg pg_ctl -D "$PGDATA" -w -t 3600 -l /tmp/pg-restore.log -o "-c listen_addresses=''" start ||
        { cat /tmp/pg-restore.log >&2; die "Could not start PostgreSQL for the restore"; }

    # Existing roles (postgres) make some statements fail; that is expected.
    sql -d postgres -v ON_ERROR_STOP=0 -f "$DUMP_DIR/globals.sql" 2>&1 | grep -v 'already exists' || true

    local db owner timescaledb file
    while IFS=$'\t' read -r db owner timescaledb file; do
        log "Restoring database $db"
        sql -d postgres -v name="$db" -v owner="$owner" <<'SQL' || rc=1
SELECT format('CREATE DATABASE %I OWNER %I', :'name', :'owner')
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'name') \gexec
SQL
        if [ "$timescaledb" = 1 ]; then
            sql -d "$db" -c 'CREATE EXTENSION IF NOT EXISTS timescaledb' </dev/null || rc=1
            sql -d "$db" -At -c 'SELECT timescaledb_pre_restore()' >/dev/null </dev/null || rc=1
        fi
        as_pg pg_restore -h "$SOCKET_DIR" -U postgres -d "$db" "$DUMP_DIR/$file" </dev/null || rc=1
        if [ "$timescaledb" = 1 ]; then
            sql -d "$db" -At -c 'SELECT timescaledb_post_restore()' >/dev/null </dev/null || rc=1
        fi
    done <"$DUMP_DIR/manifest.tsv"

    as_pg pg_ctl -D "$PGDATA" -w -t 3600 -m fast stop
    if [ "$rc" != 0 ]; then
        # Drop the half-restored cluster so the next start retries.
        rm -rf "$PGDATA"
        die "Restoring from the backup failed; the dumps are kept in $DUMP_DIR and the next start retries"
    fi
    rm -rf "$DUMP_DIR"
    touch "$ANALYZE_FLAG"
    log "Restore finished"
}

validate_options
# postgres must be able to reach its files below /data.
chmod a+x /data
mkdir -p "$SOCKET_DIR"
chown postgres:postgres "$SOCKET_DIR"
if [ -d "$PGDATA" ] && [ "$(stat -c %U "$PGDATA")" != postgres ]; then
    chown -R postgres:postgres "$PGDATA"
fi

restore=false
if [ ! -s "$PGDATA/PG_VERSION" ] && [ -f "$DUMP_DIR/manifest.tsv" ]; then
    restore=true
fi
# Dumps next to a live cluster are leftovers of an interrupted backup.
rm -rf "$DUMP_DIR.tmp"
[ "$restore" = true ] || rm -rf "$DUMP_DIR"

init_cluster
upgrade_cluster
write_config
write_hba
check_port_mapping
[ "$restore" = false ] || restore_dump

start_ingress
# Double fork so the reconciler is reparented to tini and never shows up as
# an unknown child of the postmaster.
(/usr/local/bin/addon-reconcile &)

log "Starting PostgreSQL $NEW_MAJOR with TimescaleDB"
exec su-exec postgres postgres -D "$PGDATA"
